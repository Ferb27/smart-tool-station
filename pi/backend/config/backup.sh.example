#!/usr/bin/env bash
# Mẫu, chưa chạy thử trên Pi thật
# Sao lưu SQLite mỗi ngày lúc 02:00 ra USB flash, giữ 7 bản gần nhất
# Crontab (root hoặc user pi có quyền ghi USB):
# 0 2 * * * /opt/smart-tool-station/pi/backend/config/backup.sh
# Dọn ảnh quá 30 ngày:
# 30 2 * * * find /var/lib/tram/img -type f -name "*.jpg" -mtime +30 -delete

set -euo pipefail

DB_PATH="/var/lib/tram/tram.db"
USB_DIR="/mnt/usb/tram-backup"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT_FILE="${USB_DIR}/tram-${STAMP}.db"

if [ ! -d "$USB_DIR" ]; then
  echo "Chua gan USB sao luu tai $USB_DIR" >&2
  exit 1
fi

sqlite3 "$DB_PATH" ".backup '${OUT_FILE}'"

# Giữ lại 7 bản mới nhất, xóa các bản cũ hơn
ls -1t "${USB_DIR}"/tram-*.db 2>/dev/null | tail -n +8 | xargs -r rm -f
echo "Da sao luu: ${OUT_FILE}"
