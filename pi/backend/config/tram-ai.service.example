# Mẫu, chưa chạy thử trên Pi thật
# Đường dẫn triển khai trên Pi: /etc/systemd/system/tram-ai.service

[Unit]
Description=Tram Dung Cu - Edge AI Inference Service
After=network.target tram-backend.service
Requires=tram-backend.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/smart-tool-station/pi/ai
EnvironmentFile=/etc/tram/env
ExecStart=/opt/smart-tool-station/.venv/bin/python inference_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
