# Mẫu, chưa chạy thử trên Pi thật
# Đường dẫn triển khai trên Pi: /etc/systemd/system/tram-backend.service

[Unit]
Description=Tram Dung Cu - FastAPI Backend
After=network.target hostapd.service dnsmasq.service mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/smart-tool-station/pi/backend
EnvironmentFile=/etc/tram/env
ExecStart=/opt/smart-tool-station/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
